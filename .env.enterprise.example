# Copy to .env.enterprise for Docker or .env for local development.
# Pick exactly one product data store block: json, sqlite, postgresql, or mysql.
# Pick exactly one Better Auth database block: sqlite, postgresql, mysql, mssql, or mongodb.

BATUK_HTTP_PORT=3000
BATUK_STARTUP_RETRY_ATTEMPTS=30
BATUK_STARTUP_RETRY_SECONDS=2
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_for_air_gapped_enterprise

# ---------------------------------------------------------------------------
# Product data store: local JSON files
# Stores chats, folders, workspaces, memories, skills, agents, workflows,
# documents metadata/chunks, token usage, branding, compliance, and audit data
# under BATUK_DATA_DIR-compatible app paths.
# ---------------------------------------------------------------------------
BATUK_DATA_STORE_PROVIDER=json
BATUK_DATA_DIR=/app/data
BATUK_DOCUMENT_FILE_STORAGE_PROVIDER=local
BATUK_DOCUMENT_FILE_STORAGE_DIR=/app/data/documents
BATUK_BRANDING_FILE_STORAGE_DIR=/app/public/branding

# ---------------------------------------------------------------------------
# Product data store: SQLite
# This stores Batuk product data in /app/data/batuk-product-data.sqlite.
# To test SQLite product data, uncomment this block and comment the JSON,
# Postgres, and MySQL product data store blocks.
# ---------------------------------------------------------------------------
# BATUK_DATA_STORE_PROVIDER=sqlite
# BATUK_DATA_SQLITE_PATH=/app/data/batuk-product-data.sqlite
# BATUK_DOCUMENT_FILE_STORAGE_PROVIDER=local
# BATUK_DOCUMENT_FILE_STORAGE_DIR=/app/data/documents
# BATUK_BRANDING_FILE_STORAGE_DIR=/app/public/branding

# ---------------------------------------------------------------------------
# Product data store: PostgreSQL
# To test Postgres, uncomment this block and comment the JSON/MySQL product
# data store blocks. In Docker Compose, run:
# docker compose --profile postgres up --build
# ---------------------------------------------------------------------------
# BATUK_DATA_STORE_PROVIDER=postgresql
# BATUK_DATA_DATABASE_URL=postgresql://batuk:batuk_password@postgres:5432/batuk
# BATUK_DATA_POSTGRES_HOST=postgres
# BATUK_DATA_POSTGRES_PORT=5432
# BATUK_DATA_POSTGRES_DATABASE=batuk
# BATUK_DATA_POSTGRES_USER=batuk
# BATUK_DATA_POSTGRES_PASSWORD=batuk_password
# BATUK_DATA_POSTGRES_SCHEMA=
# BATUK_DATA_STATE_TABLE=batuk_app_state
# BATUK_DOCUMENT_FILE_STORAGE_PROVIDER=local
# BATUK_DOCUMENT_FILE_STORAGE_DIR=/app/data/documents
# BATUK_BRANDING_FILE_STORAGE_DIR=/app/public/branding

# ---------------------------------------------------------------------------
# Product data store: MySQL
# To test MySQL, uncomment this block and comment the JSON/Postgres product
# data store blocks. In Docker Compose, run:
# docker compose --profile mysql up --build
# ---------------------------------------------------------------------------
# BATUK_DATA_STORE_PROVIDER=mysql
# BATUK_DATA_DATABASE_URL=mysql://batuk:batuk_password@mysql:3306/batuk
# BATUK_DATA_MYSQL_HOST=mysql
# BATUK_DATA_MYSQL_PORT=3306
# BATUK_DATA_MYSQL_DATABASE=batuk
# BATUK_DATA_MYSQL_USER=batuk
# BATUK_DATA_MYSQL_PASSWORD=batuk_password
# BATUK_DATA_MYSQL_ROOT_PASSWORD=batuk_root_password
# BATUK_DATA_STATE_TABLE=batuk_app_state
# BATUK_DOCUMENT_FILE_STORAGE_PROVIDER=local
# BATUK_DOCUMENT_FILE_STORAGE_DIR=/app/data/documents
# BATUK_BRANDING_FILE_STORAGE_DIR=/app/public/branding

# ---------------------------------------------------------------------------
# Better Auth DB: local SQLite default
# ---------------------------------------------------------------------------
BETTER_AUTH_DATABASE_PROVIDER=sqlite
BETTER_AUTH_DB_PATH=/app/data/sb-chat-auth.sqlite

# ---------------------------------------------------------------------------
# Better Auth DB: PostgreSQL
# Uncomment to store auth users, sessions, organizations, teams, invitations,
# roles, OAuth/OIDC clients, SSO, and SCIM data in Postgres.
# ---------------------------------------------------------------------------
# BETTER_AUTH_DATABASE_PROVIDER=postgresql
# BETTER_AUTH_DATABASE_URL=postgresql://batuk:batuk_password@postgres:5432/batuk
# BETTER_AUTH_POSTGRES_HOST=postgres
# BETTER_AUTH_POSTGRES_PORT=5432
# BETTER_AUTH_POSTGRES_DATABASE=batuk
# BETTER_AUTH_POSTGRES_USER=batuk
# BETTER_AUTH_POSTGRES_PASSWORD=batuk_password
# BETTER_AUTH_POSTGRES_SCHEMA=

# ---------------------------------------------------------------------------
# Better Auth DB: MySQL
# Uncomment to store auth users, sessions, organizations, teams, invitations,
# roles, OAuth/OIDC clients, SSO, and SCIM data in MySQL.
# ---------------------------------------------------------------------------
# BETTER_AUTH_DATABASE_PROVIDER=mysql
# BETTER_AUTH_DATABASE_URL=mysql://batuk:batuk_password@mysql:3306/batuk
# BETTER_AUTH_MYSQL_HOST=mysql
# BETTER_AUTH_MYSQL_PORT=3306
# BETTER_AUTH_MYSQL_DATABASE=batuk
# BETTER_AUTH_MYSQL_USER=batuk
# BETTER_AUTH_MYSQL_PASSWORD=batuk_password

# ---------------------------------------------------------------------------
# Better Auth DB: MS SQL
# Supported for Better Auth identity storage. Product data supports JSON,
# SQLite, Postgres, or MySQL.
# ---------------------------------------------------------------------------
# BETTER_AUTH_DATABASE_PROVIDER=mssql
# BETTER_AUTH_MSSQL_HOST=mssql
# BETTER_AUTH_MSSQL_PORT=1433
# BETTER_AUTH_MSSQL_DATABASE=batuk
# BETTER_AUTH_MSSQL_USER=sa
# BETTER_AUTH_MSSQL_PASSWORD=replace_with_strong_password
# BETTER_AUTH_MSSQL_ENCRYPT=false
# BETTER_AUTH_MSSQL_TRUST_SERVER_CERTIFICATE=true

# ---------------------------------------------------------------------------
# Better Auth DB: MongoDB
# Supported for Better Auth identity storage. Product data supports JSON,
# SQLite, Postgres, or MySQL.
# ---------------------------------------------------------------------------
# BETTER_AUTH_DATABASE_PROVIDER=mongodb
# BETTER_AUTH_DATABASE_URL=mongodb://mongo:27017/batuk
# MONGODB_URI=mongodb://mongo:27017/batuk
# BETTER_AUTH_MONGODB_DATABASE=batuk

# ---------------------------------------------------------------------------
# Enterprise admin and organization limits
# ---------------------------------------------------------------------------
BATUK_ADMIN_USER_IDS=
BATUK_DEFAULT_ROLE=user
BATUK_ORG_MEMBER_LIMIT=500
BATUK_ORG_TEAM_LIMIT=50
BATUK_TEAM_MEMBER_LIMIT=250
BATUK_ORG_ROLE_LIMIT=25

# ---------------------------------------------------------------------------
# Better Auth Infrastructure Dashboard and Sentinel
# BETTER_AUTH_API_KEY enables Better Auth Infrastructure dashboard activity
# tracking. Leave empty for fully local/offline operation.
# ---------------------------------------------------------------------------
BETTER_AUTH_API_KEY=
BETTER_AUTH_INFRA_API_URL=
BETTER_AUTH_INFRA_KV_URL=
BETTER_AUTH_INFRA_API_TIMEOUT=3000
BETTER_AUTH_INFRA_KV_TIMEOUT=1000
BETTER_AUTH_DASH_ACTIVITY_TRACKING_ENABLED=true
BETTER_AUTH_DASH_ACTIVITY_UPDATE_INTERVAL=300000
BETTER_AUTH_SENTINEL_ENABLED=false
NEXT_PUBLIC_BETTER_AUTH_SENTINEL_ENABLED=false

# ---------------------------------------------------------------------------
# OAuth 2.1 / OIDC provider mode
# Default mode is oauth. OIDC is provided when openid is included in scopes.
# Trusted clients are JSON. Dynamic client registration can be enabled for
# internal developer portals, but unauthenticated registration should stay false
# in production.
# ---------------------------------------------------------------------------
BETTER_AUTH_PROVIDER_MODE=oauth
NEXT_PUBLIC_BETTER_AUTH_PROVIDER_MODE=oauth
BETTER_AUTH_JWKS_PATH=/jwks
BETTER_AUTH_JWT_ALG=EdDSA
BETTER_AUTH_OAUTH_LOGIN_PAGE=/
BETTER_AUTH_OAUTH_CONSENT_PAGE=/oauth/consent
BETTER_AUTH_OAUTH_SCOPES=openid,profile,email,offline_access,batuk:read,batuk:write,batuk:admin
BETTER_AUTH_OAUTH_AUDIENCES=http://localhost:3000
BETTER_AUTH_OAUTH_ACCESS_TOKEN_EXPIRES_IN=3600
BETTER_AUTH_OAUTH_REFRESH_TOKEN_EXPIRES_IN=2592000
BETTER_AUTH_OAUTH_DYNAMIC_CLIENT_REGISTRATION=true
BETTER_AUTH_OAUTH_UNAUTHENTICATED_CLIENT_REGISTRATION=false
BETTER_AUTH_OAUTH_CLIENT_DEFAULT_SCOPES=openid,profile,email
BETTER_AUTH_OAUTH_CLIENT_ALLOWED_SCOPES=offline_access,batuk:read
BETTER_AUTH_OAUTH_CLIENT_SECRET_EXPIRATION=
BETTER_AUTH_OAUTH_CACHED_TRUSTED_CLIENTS=
BETTER_AUTH_OAUTH_TRUSTED_CLIENTS=[]
# Example trusted OAuth/OIDC client JSON:
# BETTER_AUTH_OAUTH_TRUSTED_CLIENTS=[{"clientId":"internal-portal","clientSecret":"replace_me","name":"Internal Portal","redirectURLs":["https://portal.example.com/callback"],"scopes":["openid","profile","email","batuk:read"]}]

# ---------------------------------------------------------------------------
# Legacy OIDC provider mode
# Use only when a client specifically needs Better Auth's legacy OIDC provider.
# Switch BETTER_AUTH_PROVIDER_MODE=legacy-oidc to activate these settings.
# ---------------------------------------------------------------------------
BETTER_AUTH_OIDC_LOGIN_PAGE=/
BETTER_AUTH_OIDC_CONSENT_PAGE=/oauth/consent
BETTER_AUTH_OIDC_DYNAMIC_CLIENT_REGISTRATION=false
BETTER_AUTH_OIDC_TRUSTED_CLIENTS=[]
# Example legacy OIDC client JSON:
# BETTER_AUTH_OIDC_TRUSTED_CLIENTS=[{"clientId":"legacy-client","clientSecret":"replace_me","redirectURLs":["https://legacy.example.com/oidc/callback"]}]

# ---------------------------------------------------------------------------
# Enterprise SSO providers
# defaultSSO is JSON for preconfigured OIDC/SAML providers.
# SSO providers created through Better Auth APIs are stored in the auth DB.
# ---------------------------------------------------------------------------
BETTER_AUTH_SSO_PROVIDERS_LIMIT=25
BETTER_AUTH_SSO_REDIRECT_URI=/api/auth/sso/callback
BETTER_AUTH_DEFAULT_SSO=[]
BETTER_AUTH_SSO_DISABLE_IMPLICIT_SIGN_UP=false
BETTER_AUTH_SSO_OVERRIDE_USER_INFO=false
BETTER_AUTH_SSO_DOMAIN_VERIFICATION_ENABLED=true
NEXT_PUBLIC_BETTER_AUTH_SSO_DOMAIN_VERIFICATION_ENABLED=true
BETTER_AUTH_SSO_DOMAIN_TOKEN_PREFIX=batuk-sso
BETTER_AUTH_SSO_ORG_PROVISIONING_DISABLED=false
BETTER_AUTH_SSO_DEFAULT_ORG_ROLE=member
BETTER_AUTH_SSO_PROVISION_ON_EVERY_LOGIN=true
# Example OIDC SSO provider JSON:
# BETTER_AUTH_DEFAULT_SSO=[{"providerId":"okta","issuer":"https://example.okta.com/oauth2/default","domain":"example.com","clientId":"replace_me","clientSecret":"replace_me","authorizationEndpoint":"https://example.okta.com/oauth2/default/v1/authorize","tokenEndpoint":"https://example.okta.com/oauth2/default/v1/token","userinfoEndpoint":"https://example.okta.com/oauth2/default/v1/userinfo","jwksEndpoint":"https://example.okta.com/oauth2/default/v1/keys"}]

# ---------------------------------------------------------------------------
# SCIM provisioning
# SCIM providers and tokens are stored in the auth DB. defaultSCIM is JSON for
# bootstrap/default provider configuration.
# ---------------------------------------------------------------------------
BETTER_AUTH_SCIM_REQUIRED_ROLES=owner,admin
BETTER_AUTH_DEFAULT_SCIM=[]
BETTER_AUTH_SCIM_PROVIDER_OWNERSHIP_ENABLED=true
BETTER_AUTH_SCIM_TRUSTED_DOMAINS=
BETTER_AUTH_SCIM_REQUIRE_EXISTING_ORG_MEMBERSHIP=true
# Example SCIM default JSON:
# BETTER_AUTH_DEFAULT_SCIM=[{"providerId":"okta-scim","organizationId":"replace_org_id","name":"Okta SCIM"}]

# ---------------------------------------------------------------------------
# Local compliance, GDPR, ISO 27001, SOC 2 audit settings
# ---------------------------------------------------------------------------
BATUK_AUDIT_ENABLED=true
BATUK_AUDIT_RETENTION_DAYS=365
BATUK_AUDIT_HASH_IDENTIFIERS=true
BATUK_AUDIT_MAX_EVENTS=10000

# ---------------------------------------------------------------------------
# AI model providers
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
AWS_BEDROCK_REGION=us-east-1
# Bedrock uses standard AWS credentials from the container environment,
# mounted AWS config, ECS/EKS task role, EC2 instance profile, or equivalent.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
GROK_API_KEY=
XAI_API_KEY=
SARVAM_API_KEY=

# Docker Compose Ollama profile defaults. Use `docker compose --profile ollama
# up --build` to start Ollama and pre-pull OLLAMA_DEFAULT_MODEL automatically.
# If you run Ollama on the host instead, set OLLAMA_BASE_URL to
# http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=gemma3:1b
BATUK_OLLAMA_PORT=11434

# ---------------------------------------------------------------------------
# Model request queue
# Chat requests are accepted into an in-process queue before calling upstream
# providers. Lower concurrency if a provider rate-limits; retries only happen
# before streamed tokens begin, so users do not receive duplicated text.
# ---------------------------------------------------------------------------
BATUK_MODEL_QUEUE_CONCURRENCY=6
BATUK_MODEL_QUEUE_RATE_LIMIT_RETRIES=4
BATUK_MODEL_QUEUE_RATE_LIMIT_BASE_DELAY_MS=1500
BATUK_MODEL_QUEUE_RATE_LIMIT_MAX_DELAY_MS=30000

# ---------------------------------------------------------------------------
# RAG embedding defaults
# Supported providers: local, openai, llamaindex-openai, llamaindex-ollama.
# `local` is deterministic/offline. `llamaindex-ollama` uses OLLAMA_BASE_URL.
# ---------------------------------------------------------------------------
BATUK_EMBEDDING_PROVIDER=local
BATUK_EMBEDDING_MODEL=local-hash-v1

# ---------------------------------------------------------------------------
# Vector DB and RAG settings
# Use json for local vectors, chroma for local/air-gapped vector service,
# pinecone or qdrant for managed vector storage, or supabase for Supabase
# Storage plus Postgres/pgvector RAG.
# ---------------------------------------------------------------------------
BATUK_VECTOR_STORE_PROVIDER=json
BATUK_LOCAL_VECTOR_DIR=/app/data/vectors

# ChromaDB local container:
# docker compose --profile postgres --profile chroma up --build
# BATUK_VECTOR_STORE_PROVIDER=chroma
# CHROMA_URL=http://chroma:8000
# CHROMA_COLLECTION=sb_chat_documents

# Pinecone:
# BATUK_VECTOR_STORE_PROVIDER=pinecone
# PINECONE_API_KEY=
# PINECONE_INDEX=sb-chat-documents
# PINECONE_NAMESPACE=documents
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Qdrant Cloud:
# Create a Qdrant Cloud cluster and API key, then use the HTTPS cluster URL.
# BATUK_VECTOR_STORE_PROVIDER=qdrant
# QDRANT_URL=https://xyz-example.eu-central.aws.cloud.qdrant.io
# QDRANT_API_KEY=
# QDRANT_COLLECTION=batuk_documents

# Supabase RAG:
# Run database/supabase/001_rag_storage.sql in Supabase before using this.
# BATUK_DOCUMENT_FILE_STORAGE_PROVIDER=supabase
# BATUK_VECTOR_STORE_PROVIDER=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DOCUMENT_BUCKET=batuk-documents
# SUPABASE_DOCUMENT_CHUNKS_TABLE=batuk_document_chunks
# SUPABASE_MATCH_DOCUMENTS_FUNCTION=match_batuk_document_chunks
